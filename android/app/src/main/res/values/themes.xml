<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose supplies the real theme; this styles the window around it. -->
    <style name="Theme.LRMS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/brand_dark</item>
        <item name="android:windowBackground">#F4F6FA</item>
    </style>

    <!--
        The launch window. Android draws this before the process is ready, so the
        D2 mark appears immediately instead of a blank navy rectangle.

        The splash attributes are API 31+; older versions ignore them and simply
        show windowBackground, which is the brand navy, so nothing looks broken at
        minSdk 24 — it just does not animate the mark.
    -->
    <style name="Theme.LRMS.Launch" parent="Theme.LRMS">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/brand</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_logo</item>
    </style>
</resources>
